---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'InteGrowSys | Fire & Life Safety Systems Integration and Smart Monitoring',
  description = 'Fire and life safety systems, planned maintenance AMC, building systems integration and configuration-based smart monitoring from InteGrowSys Pune.',
  canonicalPath = Astro.url.pathname,
  image = '/images/integrowsys-logo.jpg',
  structuredData
} = Astro.props;

const siteUrl = Astro.site ?? 'https://www.integrowsys.com';
const canonical = new URL(canonicalPath, siteUrl).toString();
const ogImage = new URL(image, siteUrl).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "InteGrowSys",
  "image": ogImage,
  "url": "https://www.integrowsys.com",
  "telephone": "+91-9860027825",
  "email": "crm@integrowsys.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "B25, Erica, Magarpatta City, Hadapsar",
    "addressLocality": "Pune",
    "addressRegion": "Maharashtra",
    "postalCode": "411013",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "18.5158",
    "longitude": "73.9272"
  },
  "description": description,
  "areaServed": ["Pune", "Maharashtra", "India"],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="generator" content={Astro.generator}/>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={ogImage}/>
  <meta property="og:site_name" content="InteGrowSys"/>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:url" content={canonical}/>
  <meta name="twitter:title" content={title}/>
  <meta name="twitter:description" content={description}/>
  <meta name="twitter:image" content={ogImage}/>

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <title>{title}</title>
</head>
<body class="min-h-screen flex flex-col bg-slate-50 text-slate-900 font-sans selection:bg-blue-600 selection:text-white">
  <a class="skip-link sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:p-4 focus:bg-white focus:shadow-lg focus:rounded-lg" href="#main">
    Skip to content
  </a>

  <Navbar />

  <main id="main" class="flex-grow">
    <slot/>
  </main>

  <Footer />
</body>
</html>
