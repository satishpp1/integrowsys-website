---
import '../styles/global.css';
const { title='InteGrowSys | Fire & Safety Systems Integration and Smart Monitoring',
description='Fire and life safety systems, planned maintenance, building systems integration and configuration-based smart monitoring from InteGrowSys.',
canonicalPath=Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://www.integrowsys.com').toString();
const nav=[{label:'Home',href:'/'},{label:'Fire & Safety',href:'/services/'},{label:'Smart Monitoring',href:'/smart-monitoring/'},{label:'Projects',href:'/projects/'},{label:'About',href:'/about/'},{label:'Contact',href:'/contact/'}];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="generator" content={Astro.generator}/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="InteGrowSys home"><img src="/images/integrowsys-logo.jpg" alt="InteGrowSys" width="190" height="70"/></a><nav aria-label="Main navigation">{nav.map(n=><a href={n.href} class:list={{active:Astro.url.pathname===n.href}}>{n.label}</a>)}</nav><a class="header-cta" href="/contact/">Request a site survey ↗</a></div></header>
<main id="main"><slot/></main><footer class="site-footer"><div class="container footer-grid"><div><a class="footer-brand" href="/">InteGrowSys</a><p>Fire & life safety, building systems integration and practical smart monitoring.</p></div><div><h2>Explore</h2><a href="/services/">Fire & Safety Services</a><a href="/smart-monitoring/">Smart Monitoring</a><a href="/projects/">Projects</a><a href="/resources/">Resources</a></div><div><h2>Contact</h2><a href="mailto:crm@integrowsys.com">crm@integrowsys.com</a><a href="tel:+919860027825">+91 98600 27825</a><a href="tel:+917507600091">+91 75076 00091</a><p>B25, Erica, Magarpatta City, Hadapsar, Pune, Maharashtra 411013</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} InteGrowSys. All rights reserved.</span><span>Protect. Monitor. Integrate. Respond.</span></div></footer></body></html>
