import MainLayout from '../../layouts/MainLayout.astro';
const items=[{title:'Fire alarm notifications',text:'Where a compatible panel provides suitable relay outputs, selected alarm or fault states may be sent to an additional notification device.'},{title:'Fire pump & equipment status',text:'Monitor selected equipment run/fault signals where suitable contacts and safe installation methods are available.'},{title:'Pressure & environmental signals',text:'Pressure, temperature, humidity or water-leak monitoring requires compatible sensors, signal interfaces and a site-specific design.'},{title:'Connectivity options',text:'Connectivity is selected for the site. Wi-Fi is documented for current AlertGuard; Ethernet, LoRa or other gateways must be verified for each offered configuration.'}];
---
<MainLayout title="Smart Monitoring & AlertGuard | InteGrowSys" description="Configuration-based monitoring and notifications for compatible legacy alarm and building equipment systems.">
<section class="page-hero"><div class="container"><div class="breadcrumbs"><a href="/">Home</a> / Smart Monitoring</div><div class="eyebrow">Smart monitoring</div><h1>Make your existing alarm system smarter.</h1><p class="lead">Add a carefully scoped monitoring layer to selected signals from compatible equipment—so the right people can be notified when something changes.</p><div class="hero-actions"><a class="button" href="/contact/">Request a system assessment</a><a class="button secondary" href="mailto:crm@integrowsys.com?subject=AlertGuard%20and%20Smart%20Monitoring">Ask about AlertGuard</a></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>What could be monitored?</h2><p>Actual scope depends on the panel, output contacts, sensor interface, power, network and notification requirements.</p></div><div class="card-grid">{items.map(x=><article class="card"><h3>{x.title}</h3><p>{x.text}</p></article>)}</div></div></section>
<section class="section soft"><div class="container content"><h2>AlertGuard: an add-on notification concept</h2><p>The current AlertGuard integration manual describes an ESP32-based add-on that monitors up to five configurable NO/NC dry-contact relay inputs. It can send email notifications and webhooks over Wi-Fi when configured inputs change state.</p><p>Its embedded web interface is documented for device health, zone status and event-log access. Confirm supported inputs, connectivity, alert routing and commissioning requirements for the specific configuration before ordering.</p><div class="notice"><strong>Scope note:</strong> Ethernet, LoRa, direct analog sensor measurements and a full cloud dashboard are not assumed to be standard AlertGuard features here. Quote them only when verified for the proposed installation.</div><h2>How an assessment works</h2><div class="steps"><div class="step"><h3>Review</h3><p>Identify equipment, make/model, outputs, signals and site risks.</p></div><div class="step"><h3>Design</h3><p>Agree monitoring points, connectivity, alert recipients and limitations.</p></div><div class="step"><h3>Commission</h3><p>Test the agreed signal path, notifications and handover records.</p></div></div></div></section>
<section class="section"><div class="container"><div class="feature-band"><div><h2>Could your legacy panel be connected?</h2><p>Send the panel make/model and a brief description of what you want to know remotely.</p></div><a class="button" href="/contact/">Start an assessment</a></div></div></section>
</MainLayout>
