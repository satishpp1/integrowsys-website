---
import MainLayout from '../layouts/MainLayout.astro';
import FireSafetyLifecycleGraphic from '../components/FireSafetyLifecycleGraphic.astro';
import { 
  Flame, 
  Cpu, 
  ShieldCheck, 
  Wrench, 
  Building2, 
  Sliders, 
  ArrowRight, 
  CheckCircle2, 
  Radio, 
  Sparkles,
  Server,
  Factory,
  Warehouse,
  MessageSquare
} from 'lucide-astro';

const services = [
  {
    icon: Flame,
    title: 'Fire Alarm & Detection',
    description: 'Conventional & addressable fire alarm panels engineered to NBC 2016 Part 4 and IS 2189 compliance.',
    href: '/services/fire-alarm-systems/',
    tag: 'Fire Safety',
    accentColor: 'border-red-200 hover:border-red-400 bg-red-50/20',
    iconBg: 'bg-red-50 text-red-600 group-hover:bg-red-600 group-hover:text-white',
    tagColor: 'bg-red-50 text-red-700',
    linkHover: 'text-red-600 group-hover:text-red-700'
  },
  {
    icon: ShieldCheck,
    title: 'Planned AMC & Form-B',
    description: 'Statutory preventive maintenance contracts, hydraulic testing, and Form-B certification across Maharashtra.',
    href: '/services/fire-safety-amc/',
    tag: 'Maintenance & AMC',
    accentColor: 'border-emerald-200 hover:border-emerald-400 bg-emerald-50/20',
    iconBg: 'bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white',
    tagColor: 'bg-emerald-50 text-emerald-700',
    linkHover: 'text-emerald-600 group-hover:text-emerald-700'
  },
  {
    icon: Cpu,
    title: 'AlertGuard™ IoT Add-On',
    description: 'ESP32 Wi-Fi hardware bridging existing dry-contact relays to instant WhatsApp, email, and webhook alerts.',
    href: '/smart-monitoring/',
    tag: 'Smart Monitoring',
    accentColor: 'border-amber-200 hover:border-amber-400 bg-amber-50/20',
    iconBg: 'bg-amber-50 text-amber-600 group-hover:bg-gradient-to-r group-hover:from-amber-500 group-hover:to-orange-600 group-hover:text-white',
    tagColor: 'bg-amber-50 text-amber-700',
    linkHover: 'text-amber-600 group-hover:text-amber-700'
  },
  {
    icon: Wrench,
    title: 'Hydrant & Sprinkler Networks',
    description: 'Piping networks, landing valves, ESFR sprinklers, and deluge valves tested to IS 13039 and IS 15105.',
    href: '/services/fire-hydrant-sprinkler/',
    tag: 'Hydraulics',
    accentColor: 'border-blue-200 hover:border-blue-400 bg-blue-50/20',
    iconBg: 'bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white',
    tagColor: 'bg-blue-50 text-blue-700',
    linkHover: 'text-blue-600 group-hover:text-blue-700'
  },
  {
    icon: Sliders,
    title: 'Building Systems Integration',
    description: 'Interlock fire alarm triggers with lift homing, staircase pressurization, and smoke dampers.',
    href: '/services/building-systems-integration/',
    tag: 'Systems Integration',
    accentColor: 'border-indigo-200 hover:border-indigo-400 bg-indigo-50/20',
    iconBg: 'bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white',
    tagColor: 'bg-indigo-50 text-indigo-700',
    linkHover: 'text-indigo-600 group-hover:text-indigo-700'
  },
  {
    icon: Radio,
    title: 'Security & ELV Infrastructure',
    description: 'CCTV surveillance, biometric access control, and structured networking aligned with facility safety.',
    href: '/services/security-elv/',
    tag: 'ELV & Security',
    accentColor: 'border-purple-200 hover:border-purple-400 bg-purple-50/20',
    iconBg: 'bg-purple-50 text-purple-600 group-hover:bg-purple-600 group-hover:text-white',
    tagColor: 'bg-purple-50 text-purple-700',
    linkHover: 'text-purple-600 group-hover:text-purple-700'
  }
];

const environments = [
  { name: 'IT / ITES Campuses', icon: Building2, desc: 'High-density office parks & server rooms', href: '/solutions/it-campuses/' },
  { name: 'Manufacturing Plants', icon: Factory, desc: 'Industrial machinery, paint booths & raw materials', href: '/solutions/manufacturing/' },
  { name: 'Warehouses & Logistics', icon: Warehouse, desc: 'High-bay racking, sprinkler heads & dock areas', href: '/solutions/warehouses/' },
  { name: 'Data & Server Rooms', icon: Server, desc: 'Clean agent suppression & micro-environment sensing', href: '/solutions/it-campuses/' },
  { name: 'Commercial High-Rises', icon: Building2, desc: 'Pressurization, wet risers & staircase evacuation', href: '/solutions/commercial-highrise/' }
];
---

<MainLayout 
  title="InteGrowSys | Fire Safety Engineering, Systems Integration & Smart Monitoring"
  description="InteGrowSys provides fire & life safety systems, planned AMC maintenance, and configuration-based AlertGuard smart monitoring in Pune and Maharashtra."
>
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-12 pb-20 lg:pt-20 lg:pb-28">
    <!-- Background subtle glow grid -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.25),rgba(255,255,255,0))] pointer-events-none"></div>
    <div class="absolute -top-40 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-10 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Content -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-800/90 border border-slate-700/80 text-xs font-bold uppercase tracking-wider">
            <span class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            </span>
            <span class="text-slate-200">Fire Safety · Systems AMC · AlertGuard™ IoT</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-heading font-black tracking-tight text-white leading-[1.12]">
            From certified fire safety to <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-400 to-red-400">smart, connected facilities.</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-300 leading-relaxed max-w-2xl font-normal">
            InteGrowSys helps facility managers maintain essential life safety systems, obtain statutory Form-B compliance, and add real-time monitoring—<span class="text-white font-semibold">without the expense of replacing functional legacy panels.</span>
          </p>

          <!-- Action Buttons (High Contrast & Logo Inspired) -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a 
              href="/contact/?enquiry=smart-monitoring" 
              class="btn-cta-primary"
            >
              <span>Make My Existing System Smart</span>
              <ArrowRight class="w-4 h-4" />
            </a>

            <a 
              href="https://wa.me/919860027825?text=Hello%20InteGrowSys%20team,%20I%20would%20like%20to%20discuss%20fire%20safety%20services" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-cta-whatsapp"
            >
              <MessageSquare class="w-4 h-4" />
              <span>Connect on WhatsApp</span>
            </a>

            <a 
              href="/services/" 
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl font-bold text-sm bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition"
            >
              Explore Services
            </a>
          </div>

          <!-- Micro Trust Marks -->
          <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-y-3 gap-x-6 text-xs text-slate-400">
            <span class="flex items-center gap-1.5 text-slate-300">
              <CheckCircle2 class="w-4 h-4 text-emerald-400" />
              Site-Specific Engineering
            </span>
            <span class="flex items-center gap-1.5 text-slate-300">
              <CheckCircle2 class="w-4 h-4 text-emerald-400" />
              Integration-Led Thinking
            </span>
            <span class="flex items-center gap-1.5 text-slate-300">
              <CheckCircle2 class="w-4 h-4 text-emerald-400" />
              Fast Pune & Regional Response
            </span>
          </div>
        </div>

        <!-- Right Visual: Connected Facility Live Telemetry Concept -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl bg-slate-800/70 border border-slate-700/80 p-6 sm:p-8 backdrop-blur-xl shadow-2xl shadow-black/50 overflow-hidden">
            <!-- Accent glow on the card -->
            <div class="absolute -right-20 -top-20 w-60 h-60 bg-blue-500/20 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center justify-between border-b border-slate-700/60 pb-4 mb-6">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-400 absolute"></div>
                <span class="text-xs font-mono font-bold tracking-wider uppercase text-emerald-400 ml-2">Telemetry Live</span>
              </div>
              <span class="text-xs text-slate-400 font-mono">AlertGuard IoT Node #01</span>
            </div>

            <div class="text-xl font-heading font-black text-white mb-2">
              Know what’s happening across your facility.
            </div>
            <p class="text-xs text-slate-400 mb-6">
              Dry-contact outputs transform legacy hardware into proactive, cloud-connected safety signals.
            </p>

            <!-- Status Rows -->
            <div class="space-y-3">
              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/60 border border-slate-700/60 text-xs">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                  <span class="font-medium text-slate-200">Main Fire Alarm Panel</span>
                </div>
                <span class="font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Normal Standby</span>
              </div>

              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/60 border border-slate-700/60 text-xs">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                  <span class="font-medium text-slate-200">Hydrant Line Pressure</span>
                </div>
                <span class="font-mono font-bold text-blue-300 bg-blue-500/10 px-2 py-0.5 rounded border border-blue-500/20">8.2 Bar (Optimal)</span>
              </div>

              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/60 border border-slate-700/60 text-xs">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-blue-400"></span>
                  <span class="font-medium text-slate-200">Diesel Fire Pump Controller</span>
                </div>
                <span class="font-bold text-slate-300 bg-slate-800 px-2 py-0.5 rounded border border-slate-700">Auto Standby</span>
              </div>

              <div class="flex items-center justify-between p-3.5 rounded-xl bg-slate-900/60 border border-slate-700/60 text-xs">
                <div class="flex items-center gap-3">
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
                  <span class="font-medium text-slate-200">Alert Notification Hub</span>
                </div>
                <span class="font-bold text-indigo-300 bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/20">Email & Webhook Ready</span>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-700/60 flex items-center justify-between text-xs text-slate-400">
              <span class="flex items-center gap-1.5">
                <Sparkles class="w-3.5 h-3.5 text-amber-400" />
                Zero disruption retrofit
              </span>
              <a href="/smart-monitoring/" class="text-blue-400 hover:text-blue-300 font-bold inline-flex items-center gap-1">
                Explore architecture →
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- TRUST & METRICS BANNER -->
  <section class="border-y border-slate-200 bg-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl font-heading font-black text-slate-900">100%</div>
          <div class="text-xs font-semibold text-slate-600 uppercase tracking-wider mt-1">NBC 2016 Aligned</div>
        </div>
        <div>
          <div class="text-3xl font-heading font-black text-orange-600">Retrofit</div>
          <div class="text-xs font-semibold text-slate-600 uppercase tracking-wider mt-1">No Hardware Rip-and-Replace</div>
        </div>
        <div>
          <div class="text-3xl font-heading font-black text-slate-900">24/7</div>
          <div class="text-xs font-semibold text-slate-600 uppercase tracking-wider mt-1">Critical Signal Readiness</div>
        </div>
        <div>
          <div class="text-3xl font-heading font-black text-emerald-600">Pune Hub</div>
          <div class="text-xs font-semibold text-slate-600 uppercase tracking-wider mt-1">Local Engineering Team</div>
        </div>
      </div>
    </div>
  </section>

  <!-- INTEGRATED SAFETY LIFECYCLE (MULTI-COLOR GRAPHIC) -->
  <section class="py-16 bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-bold uppercase tracking-wider mb-3">
          <span>The InteGrowSys Advantage</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-heading font-black text-white tracking-tight">
          An integrated fire safety lifecycle for Maharashtra facilities.
        </h2>
        <p class="text-slate-300 text-base mt-2">
          From statutory NBC 2016 engineering and quarterly Form-B maintenance to IoT remote dry-contact supervision.
        </p>
      </div>

      <FireSafetyLifecycleGraphic />
    </div>
  </section>

  <!-- CORE CAPABILITIES BENTO GRID -->
  <section class="py-20 lg:py-24 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <div class="text-xs font-bold uppercase tracking-wider text-orange-600 mb-2">Comprehensive Solutions</div>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 tracking-tight">
          Safety systems that work. Information that helps you act.
        </h2>
        <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed">
          From planned maintenance to carefully scoped monitoring upgrades, we focus on making systems genuinely useful to the engineers and facility heads responsible for safety.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((item) => {
          const Icon = item.icon;
          return (
            <article class={`group bg-white rounded-2xl p-7 border transition-all duration-200 flex flex-col justify-between shadow-sm hover:shadow-xl ${item.accentColor}`}>
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class={`w-12 h-12 rounded-xl flex items-center justify-center transition duration-200 shadow-sm ${item.iconBg}`}>
                    <Icon class="w-6 h-6" />
                  </div>
                  <span class={`text-xs font-bold px-2.5 py-1 rounded-full ${item.tagColor}`}>
                    {item.tag}
                  </span>
                </div>
                <h3 class="text-xl font-heading font-bold text-slate-900 group-hover:text-slate-800 transition mb-3">
                  {item.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-6">
                  {item.description}
                </p>
              </div>

              <a 
                href={item.href} 
                class={`inline-flex items-center gap-1.5 text-sm font-bold transition ${item.linkHover}`}
              >
                <span>Learn more</span>
                <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </a>
            </article>
          );
        })}
      </div>

    </div>
  </section>

  <!-- TWO INQUIRY PATHWAYS (QUALIFICATION SECTION) -->
  <section class="py-20 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">Start With Your Goal</div>
        <h2 class="text-3xl sm:text-4xl font-heading font-extrabold text-slate-900 tracking-tight">
          What would you like to improve at your facility?
        </h2>
        <p class="text-base text-slate-600 mt-3">
          Select the pathway matching your immediate requirement. Sharing site context helps our engineers prepare a meaningful preliminary review.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto">
        
        <!-- Pathway 1: Fire Safety & AMC -->
        <div class="rounded-3xl p-8 sm:p-10 bg-slate-50 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center">
              <Flame class="w-6 h-6" />
            </div>
            <div>
              <div class="text-xs font-bold text-amber-700 uppercase tracking-wider">Maintenance & Compliance</div>
              <h3 class="text-2xl font-heading font-bold text-slate-900 mt-1">
                Maintain, repair or certify your fire systems.
              </h3>
            </div>
            <p class="text-sm text-slate-600 leading-relaxed">
              Designed for facility and operations teams seeking statutory compliance, Annual Maintenance Contracts (AMC), fire safety audits, pump room overhauls, or staff emergency training.
            </p>

            <ul class="space-y-2.5 text-sm text-slate-700 pt-2">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Quarterly preventive service with signed reports</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Form-B statutory compliance documentation</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Emergency troubleshooting & replacement spares</span>
              </li>
            </ul>
          </div>

          <div class="pt-8 mt-6 border-t border-slate-200/80">
            <a 
              href="/contact/?enquiry=fire-safety" 
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-slate-900 hover:bg-slate-800 text-white shadow-md transition"
            >
              <span>Enquire About Fire Safety AMC</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Pathway 2: Smart Monitoring Retrofit -->
        <div class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-blue-900 to-indigo-950 text-white shadow-xl flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-20 -bottom-20 w-60 h-60 bg-blue-500/20 rounded-full blur-3xl pointer-events-none"></div>

          <div class="space-y-5 relative z-10">
            <div class="w-12 h-12 rounded-2xl bg-white/10 text-blue-300 border border-white/10 flex items-center justify-center">
              <Cpu class="w-6 h-6" />
            </div>
            <div>
              <div class="text-xs font-bold text-blue-300 uppercase tracking-wider">AlertGuard IoT Retrofit</div>
              <h3 class="text-2xl font-heading font-bold text-white mt-1">
                Make your existing legacy equipment smarter.
              </h3>
            </div>
            <p class="text-sm text-slate-300 leading-relaxed">
              For teams wanting remote alerts, pump trip notifications, water leak warnings, and pressure threshold monitoring without discarding functioning panels.
            </p>

            <ul class="space-y-2.5 text-sm text-slate-200 pt-2">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Connects to dry-contact relay outputs (NO/NC)</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Email and webhook escalations within seconds</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
                <span>Local Wi-Fi or cellular gateway architecture</span>
              </li>
            </ul>
          </div>

          <div class="pt-8 mt-6 border-t border-white/10 relative z-10">
            <a 
              href="/contact/?enquiry=smart-monitoring" 
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-900/40 transition"
            >
              <span>Enquire About Smart Monitoring</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

      </div>

      <div class="mt-8 text-center text-xs text-slate-500">
        Monitoring feasibility is evaluated during the engineering survey based on installed equipment, contact outputs, and connectivity.
      </div>
    </div>
  </section>

  <!-- ENVIRONMENTS & FACILITY TYPES -->
  <section class="py-16 bg-slate-100 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-xl mx-auto mb-10">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500">Tailored For Real-World Facilities</h3>
        <p class="text-lg font-heading font-bold text-slate-800 mt-1">
          Engineered to match distinct facility operating risks.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {environments.map((env) => {
          const Icon = env.icon;
          return (
            <a 
              href={env.href}
              class="group bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:border-blue-300 hover:shadow-md transition flex flex-col justify-between"
            >
              <div>
                <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center mb-3 group-hover:bg-blue-600 group-hover:text-white transition duration-200">
                  <Icon class="w-5 h-5" />
                </div>
                <div class="font-bold text-slate-800 text-sm mb-1 group-hover:text-blue-600 transition">{env.name}</div>
                <div class="text-xs text-slate-500 leading-snug">{env.desc}</div>
              </div>
              <div class="mt-3 text-[11px] font-bold text-blue-600 flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <span>Explore solution</span>
                <span>→</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA BANNER (HIGH CONTRAST & LOGO SPECTRUM ACCENTS) -->
  <section class="relative py-20 bg-slate-950 text-white border-t border-slate-800 overflow-hidden">
