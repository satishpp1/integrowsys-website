---
import MainLayout from '../../layouts/MainLayout.astro';
import { 
  Building2, 
  Hospital, 
  Sliders, 
  CheckCircle2, 
  ArrowRight, 
  Phone
} from 'lucide-astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.integrowsys.com/" },
    { "@type": "ListItem", "position": 2, "name": "Solutions", "item": "https://www.integrowsys.com/solutions/" },
    { "@type": "ListItem", "position": 3, "name": "Commercial High-Rises & Hospitals", "item": "https://www.integrowsys.com/solutions/commercial-highrise/" }
  ]
};
---

<MainLayout 
  title="Fire Safety for Commercial High-Rises & Hospitals in Pune | InteGrowSys" 
  description="Multi-storey life safety systems, wet risers, staircase pressurization, basement smoke ventilation, and Form-B certification for high-rises and healthcare facilities."
  canonicalPath="/solutions/commercial-highrise/"
  structuredData={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-16 lg:py-24 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6" aria-label="Breadcrumbs">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/solutions/" class="hover:text-white transition">Solutions</a>
        <span>/</span>
        <span class="text-blue-400">Commercial High-Rises & Hospitals</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-400/20 text-indigo-300 text-xs font-bold uppercase tracking-wider mb-4">
          <Building2 class="w-3.5 h-3.5 text-indigo-400" />
          <span>Vertical Occupancy & Life Safety</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-heading font-black tracking-tight text-white leading-tight">
          Life Safety for <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-blue-300 to-emerald-400">Commercial High-Rises & Healthcare.</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 mt-4 leading-relaxed">
          Tall structures and hospitals in Pune require specialized hydraulic zoning, pressure-balanced wet risers, staircase smoke management, and synchronized public address evacuation to protect vertical populations.
        </p>
        <div class="flex flex-wrap items-center gap-4 mt-8">
          <a 
            href="/contact/?enquiry=fire-safety" 
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition"
          >
            <span>Request Building Inspection</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a 
            href="tel:+919860027825" 
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 transition"
          >
            <Phone class="w-4 h-4 text-emerald-400" />
            <span>Call +91 98600 27825</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- High-Rise Pillars -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">Vertical Life Safety</div>
        <h2 class="text-3xl font-heading font-bold text-slate-900">
          Engineered to manage vertical evacuation and smoke migration
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <Building2 class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900">Zoned Wet Riser Pressure Regulation</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Pressure Reducing Valves (PRVs) and orifice plates calibrated floor-by-floor to ensure a steady 3.5 bar at top floors while limiting lower-floor static pressure below 7 bar.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Prevents hose whip and firefighter injury</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>NBC 2016 Part 4 Table 7 compliance</span>
            </li>
          </ul>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <Sliders class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900">Basement Jet Fans & Smoke Extraction</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Multi-level basement carpark smoke ventilation with high-velocity impulse jet fans, CO level sensors, and 250°C/2-hr rated smoke exhaust blowers.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Automated CO sweep ventilation</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Full smoke clearance for fire brigade entry</span>
            </li>
          </ul>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <Hospital class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900">Hospital & Healthcare Life Safety</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Specialized compartmentation for patient care areas, ICU gas shutoff integration, visual strobe alert synchronization, and horizontal progressive evacuation planning.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>NABH accreditation fire safety standards</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Zero false alarm acoustic planning</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>
</MainLayout>
