---
import MainLayout from '../../layouts/MainLayout.astro';
import { 
  Factory, 
  Flame, 
  Sliders, 
  CheckCircle2, 
  ArrowRight, 
  ShieldCheck, 
  Phone
} from 'lucide-astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.integrowsys.com/" },
    { "@type": "ListItem", "position": 2, "name": "Solutions", "item": "https://www.integrowsys.com/solutions/" },
    { "@type": "ListItem", "position": 3, "name": "Manufacturing & Industrial Plants", "item": "https://www.integrowsys.com/solutions/manufacturing/" }
  ]
};
---

<MainLayout 
  title="Fire Safety & Industrial Protection for Manufacturing Plants | InteGrowSys" 
  description="Heavy-duty fire protection, high-head hydrant rings, diesel pump readiness, and DISH audit compliance for manufacturing facilities in Chakan, Bhosari, and Ranjangaon."
  canonicalPath="/solutions/manufacturing/"
  structuredData={breadcrumbSchema}
>
  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-16 lg:py-24 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6" aria-label="Breadcrumbs">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/solutions/" class="hover:text-white transition">Solutions</a>
        <span>/</span>
        <span class="text-blue-400">Manufacturing & Industrial</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-400/20 text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
          <Factory class="w-3.5 h-3.5 text-amber-400" />
          <span>Industrial Heavy Hazard</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-heading font-black tracking-tight text-white leading-tight">
          Heavy-Duty Fire Engineering for <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-red-400">Manufacturing Plants.</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-300 mt-4 leading-relaxed">
          Factories in Chakan, Bhosari, Talegaon, and Ranjangaon demand robust systems that handle industrial heat, dust, flammable raw materials, paint booths, and large outdoor yards without false trips or pump failures.
        </p>
        <div class="flex flex-wrap items-center gap-4 mt-8">
          <a 
            href="/contact/?enquiry=fire-safety" 
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition"
          >
            <span>Request Plant Survey</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a 
            href="tel:+919860027825" 
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 transition"
          >
            <Phone class="w-4 h-4 text-emerald-400" />
            <span>Call +91 98600 27825</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Industrial Engineering Pillars -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="text-xs font-bold uppercase tracking-wider text-blue-600 mb-2">Industrial Protection</div>
        <h2 class="text-3xl font-heading font-bold text-slate-900">
          Engineered for production floors and hazardous storage
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center">
            <Flame class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900">High-Head Hydrant Ring Mains</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Heavy-gauge MS Class C underground ring mains with isolation valves, double-headed yard hydrants, and foam proportioner integration for flammable solvent and fuel yards.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>IS 15301 / IS 13039 industrial layout</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Pressure holding tests at 14+ bar</span>
            </li>
          </ul>
        </div>

        <!-- Feature 2 -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <Sliders class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900">Diesel Pump Auto-Crank Reliability</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Industrial diesel engines, Star-Delta electrical pump panels, and dual-battery starter consoles inspected to ensure guaranteed cut-in within 15 seconds of a power drop.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Battery low-voltage warning telemetry</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Automatic fuel supply solenoid check</span>
            </li>
          </ul>
        </div>

        <!-- Feature 3 -->
        <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <ShieldCheck class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-heading font-bold text-slate-900">DISH & Maharashtra Fire Act Audits</h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Statutory audits and Form-B certification support aligned with the Directorate of Industrial Safety & Health (DISH) and MIDC fire department requirements.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Factory Act compliance gap reports</span>
            </li>
            <li class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Emergency mock drill certifications</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </section>
</MainLayout>
