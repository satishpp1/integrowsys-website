---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { 
  ArrowRight, 
  Phone, 
  ShieldCheck
} from 'lucide-astro';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => !data.draft);
  return services.map(service => ({
    params: { slug: service.id },
    props: { service }
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const otherServices = (await getCollection('services', ({ data }) => !data.draft))
  .filter(s => s.id !== service.id)
  .slice(0, 4);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.integrowsys.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Services",
      "item": "https://www.integrowsys.com/services/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": service.data.title,
      "item": `https://www.integrowsys.com/services/${service.id}/`
    }
  ]
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.data.title,
  "serviceType": service.data.category,
  "description": service.data.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "InteGrowSys",
    "telephone": "+91-9860027825",
    "email": "crm@integrowsys.com"
  },
  "areaServed": "Pune, Maharashtra, India"
};
---

<MainLayout 
  title={`${service.data.title} | InteGrowSys`} 
  description={service.data.description} 
  canonicalPath={`/services/${service.id}/`}
  structuredData={[breadcrumbSchema, serviceSchema]}
>
  <!-- Hero Section -->
  <section class="bg-slate-900 text-white py-14 lg:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-4" aria-label="Breadcrumbs">
        <a href="/" class="hover:text-white transition">Home</a>
        <span>/</span>
        <a href="/services/" class="hover:text-white transition">Services</a>
        <span>/</span>
        <span class="text-blue-400">{service.data.title}</span>
      </nav>

      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-400/20 text-blue-300 text-xs font-bold uppercase tracking-wider mb-4">
        {service.data.category}
      </div>

      <h1 class="text-3xl sm:text-5xl font-heading font-black tracking-tight text-white max-w-4xl">
        {service.data.title}
      </h1>

      <p class="text-slate-300 text-base sm:text-lg mt-4 max-w-3xl leading-relaxed">
        {service.data.description}
      </p>

      <div class="flex flex-wrap items-center gap-4 mt-8">
        <a 
          href="/contact/?enquiry=fire-safety" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-600/30 transition"
        >
          <span>Request a Technical Quotation</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a 
          href="tel:+919860027825" 
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm bg-slate-800 text-slate-200 border border-slate-700 hover:bg-slate-700 transition"
        >
          <Phone class="w-4 h-4 text-emerald-400" />
          <span>Call +91 98600 27825</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Main Content + Sidebar -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Markdown Body -->
        <div class="lg:col-span-8 bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm">
          <div class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:font-bold prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-lg prose-p:text-slate-600 prose-p:leading-relaxed prose-li:text-slate-600">
            <Content />
          </div>

          <!-- Bottom Action Box -->
          <div class="mt-12 pt-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-6 bg-slate-50 p-6 rounded-2xl">
            <div>
              <div class="font-heading font-bold text-slate-900 text-base">
                Ready to scope this service for your site?
              </div>
              <p class="text-xs text-slate-500 mt-0.5">
                Our Pune engineering team provides site inspections across Maharashtra.
              </p>
            </div>
            <a 
              href="/contact/" 
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm bg-blue-600 text-white hover:bg-blue-700 transition shrink-0"
            >
              <span>Book Site Survey</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- Key Standards Box -->
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
            <h3 class="font-heading font-bold text-slate-900 text-sm uppercase tracking-wider text-slate-400">
              Standards & Compliance
            </h3>
            <ul class="space-y-2.5 text-xs text-slate-700">
              <li class="flex items-start gap-2">
                <ShieldCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span>National Building Code (NBC) 2016 Part 4 Standards</span>
              </li>
              <li class="flex items-start gap-2">
                <ShieldCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span>Maharashtra Fire Prevention & Life Safety Act</span>
              </li>
              <li class="flex items-start gap-2">
                <ShieldCheck class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                <span>Form-B Certification & Maintenance Verification</span>
              </li>
            </ul>
          </div>

          <!-- Other Services Navigation -->
          <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
            <h3 class="font-heading font-bold text-slate-900 text-sm uppercase tracking-wider text-slate-400">
              Related Capabilities
            </h3>
            <div class="space-y-2">
              {otherServices.map((other) => (
                <a 
                  href={`/services/${other.id}/`} 
                  class="block p-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-200"
                >
                  <div class="font-bold text-slate-800 text-xs hover:text-blue-600 transition">
                    {other.data.title}
                  </div>
                  <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">
                    {other.data.description}
                  </div>
                </a>
              ))}
            </div>
            <a href="/services/" class="block pt-2 text-xs font-bold text-blue-600 hover:text-blue-700">
              View all capabilities →
            </a>
          </div>

        </div>

      </div>
    </div>
  </section>
</MainLayout>
