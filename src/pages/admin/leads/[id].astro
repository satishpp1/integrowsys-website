---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { 
  ArrowLeft, 
  Building2, 
  MessageSquare, 
  FileText, 
  Send 
} from '@lucide/astro';

export function getStaticPaths() {
  return [
    { params: { id: 'view' } }
  ];
}
---

<AdminLayout title="Lead Details | InteGrowSys Admin">
  <!-- Top Navigation Bar -->
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <a 
          href="/admin/leads" 
          class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-blue-600 transition"
        >
          <ArrowLeft class="w-3.5 h-3.5" />
          <span>Back to All Leads</span>
        </a>
      </div>
      <h1 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 tracking-tight" id="lead-heading">
        Lead Record
      </h1>
      <p id="lead-breadcrumb" class="text-xs text-slate-500 mt-1">Loading enquiry details...</p>
    </div>

    <!-- Quick Status Dropdown in Header -->
    <div class="flex items-center gap-3">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Status:</span>
      <select 
        id="status-select" 
        class="px-4 py-2 rounded-xl border border-slate-300 bg-white text-xs font-bold text-slate-900 focus:ring-2 focus:ring-blue-500 outline-none shadow-sm cursor-pointer"
        aria-label="Lead status"
      >
        <option value="new">New</option>
        <option value="contacted">Contacted</option>
        <option value="qualified">Qualified</option>
        <option value="proposal">Proposal Sent</option>
        <option value="won">Won / Contract Closed</option>
        <option value="lost">Lost</option>
        <option value="spam">Spam / Junk</option>
      </select>
    </div>
  </header>

  <!-- Main 2-Column Detail Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Contact & Enquiry Details -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Card 1: Contact Information -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-6">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-600 border-b border-slate-100 pb-3">
          <Building2 class="w-4 h-4" />
          <span>Contact & Organization</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">Full Name</div>
            <div class="font-bold text-slate-900 text-base" id="f-name">—</div>
          </div>

          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">Company / Organization</div>
            <div class="font-semibold text-slate-800" id="f-company">—</div>
          </div>

          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">Designation / Role</div>
            <div class="font-medium text-slate-700" id="f-designation">—</div>
          </div>

          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">Facility Type</div>
            <div class="font-medium text-slate-700" id="f-facility">—</div>
          </div>

          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">Phone & Immediate Actions</div>
            <div class="flex flex-wrap items-center gap-2 mt-1">
              <a href="#" id="f-phone" class="font-mono font-bold text-blue-600 hover:underline">—</a>
              <a 
                href="#" 
                id="f-whatsapp-btn" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hidden inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition"
              >
                <span>WhatsApp</span>
              </a>
            </div>
          </div>

          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">Email Address</div>
            <div>
              <a href="#" id="f-email" class="font-medium text-blue-600 hover:underline break-all">—</a>
            </div>
          </div>

          <div class="sm:col-span-2">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-0.5">City / Site Location</div>
            <div class="font-medium text-slate-700" id="f-city">—</div>
          </div>
        </div>
      </div>

      <!-- Card 2: Enquiry Message & Technical Details -->
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-5">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-600 border-b border-slate-100 pb-3">
          <FileText class="w-4 h-4" />
          <span>Enquiry Scope & Message</span>
        </div>

        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Service Interest</div>
          <span id="f-service" class="inline-block text-xs font-bold text-blue-700 bg-blue-50 px-3 py-1.5 rounded-lg border border-blue-200">
            —
          </span>
        </div>

        <div>
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Client Message / Scope Notes</div>
          <div 
            id="f-message" 
            class="p-4 rounded-xl bg-slate-50 border border-slate-200/70 text-slate-800 text-sm whitespace-pre-wrap leading-relaxed font-sans"
          >
            —
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-100 text-xs">
          <div>
            <span class="text-slate-400 block font-semibold">Source Page:</span>
            <span id="f-source" class="font-mono text-slate-700 font-bold">—</span>
          </div>
          <div>
            <span class="text-slate-400 block font-semibold">Created At:</span>
            <span id="f-created" class="text-slate-700">—</span>
          </div>
          <div>
            <span class="text-slate-400 block font-semibold">Last Updated:</span>
            <span id="f-updated" class="text-slate-700">—</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Right Column: Internal Follow-up Notes -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-6 sticky top-24">
        
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-blue-600">
            <MessageSquare class="w-4 h-4" />
            <span>Internal Notes & Follow-ups</span>
          </div>
          <span class="text-[11px] text-slate-400 font-medium">Team Only</span>
        </div>

        <!-- Notes Timeline -->
        <div class="space-y-3 max-h-[420px] overflow-y-auto pr-1" id="notes-list">
          <div class="py-8 text-center text-slate-400 text-xs">Loading notes timeline...</div>
        </div>

        <!-- Add Note Form -->
        <form class="space-y-3 pt-4 border-t border-slate-100" id="note-form">
          <label for="note-text" class="block text-xs font-bold text-slate-700">Add Internal Note</label>
          <textarea 
            id="note-text" 
            placeholder="Record site visit observations, quotation status, client feedback, or phone call notes..." 
            aria-label="Note text" 
            required
            rows="3"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none leading-relaxed"
          ></textarea>
          <div class="flex justify-end">
            <button 
              type="submit" 
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-xs bg-slate-900 hover:bg-blue-600 text-white transition active:scale-[0.98]"
            >
              <Send class="w-3.5 h-3.5" />
              <span>Post Note</span>
            </button>
          </div>
        </form>

      </div>
    </div>

  </div>
</AdminLayout>

<script>
interface LeadRecord {
  id: string;
  name: string;
  company?: string | null;
  designation?: string | null;
  email?: string | null;
  phone: string;
  city?: string | null;
  facility_type?: string | null;
  service_interest: string;
  message: string;
  source_path?: string | null;
  status: string;
  created_at: number;
  updated_at: number;
}

interface NoteRecord {
  id: string;
  lead_id: string;
  author: string;
  text: string;
  created_at: number;
}

const leadId = new URLSearchParams(window.location.search).get('id') ||
               window.location.pathname.split('/').filter(Boolean).pop() || '';

let currentLead: LeadRecord | null = null;

const statusSelect = document.getElementById('status-select') as HTMLSelectElement | null;
const noteForm = document.getElementById('note-form') as HTMLFormElement | null;
const noteText = document.getElementById('note-text') as HTMLTextAreaElement | null;
const notesList = document.getElementById('notes-list');

const ESC_MAP: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;'
};

function escapeHtml(str: unknown): string {
  return String(str ?? '').replace(/[&<>"']/g, c => ESC_MAP[c] || c);
}

function formatDateTime(ts: unknown): string {
  if (!ts) return '—';
  const d = new Date(typeof ts === 'number' ? ts * 1000 : String(ts));
  return d.toLocaleString('en-IN', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function showToast(message: string, type: 'info' | 'success' | 'error' = 'info') {
  const existing = document.querySelector('.admin-toast');
  if (existing) existing.remove();
  const toast = document.createElement('div');
  const bg = type === 'success' ? 'bg-emerald-600 text-white' : type === 'error' ? 'bg-rose-600 text-white' : 'bg-slate-900 text-white';
  toast.className = `admin-toast fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-xl font-bold text-xs shadow-xl transition-all ${bg}`;
  toast.textContent = message;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3500);
}

function renderNotes(notes: NoteRecord[]) {
  if (!notesList) return;
  if (!notes.length) {
    notesList.innerHTML = `<div class="py-8 text-center text-slate-400 text-xs">No internal notes added yet. Use the box below to post update notes.</div>`;
    return;
  }
  notesList.innerHTML = notes.map(note => `
    <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/70 text-xs space-y-1.5">
      <div class="flex items-center justify-between text-[11px] text-slate-400">
        <span class="font-bold text-slate-700">${escapeHtml(note.author || 'Admin')}</span>
        <span>${formatDateTime(note.created_at)}</span>
      </div>
      <div class="text-slate-800 leading-relaxed font-sans whitespace-pre-wrap">${escapeHtml(note.text)}</div>
    </div>
  `).join('');
}

async function loadNotes() {
  if (!notesList || !leadId || leadId === 'view') return;
  try {
    const res = await fetch(`/api/admin/leads/${encodeURIComponent(leadId)}/notes`);
    const data = (await res.json()) as { data?: NoteRecord[] };
    renderNotes(data.data ?? []);
  } catch (err) {
    console.error('Load notes failed:', err);
    notesList.innerHTML = `<div class="py-6 text-center text-rose-600 text-xs">Failed to load notes</div>`;
  }
}

function renderLead(lead: LeadRecord) {
  const heading = document.getElementById('lead-heading');
  const breadcrumb = document.getElementById('lead-breadcrumb');
  if (heading) {
    heading.textContent = lead.name;
  }
  if (breadcrumb) {
    breadcrumb.textContent = `${lead.company || 'Direct'} · ${lead.service_interest} · Submitted on ${formatDateTime(lead.created_at)}`;
  }

  const fName = document.getElementById('f-name');
  const fCompany = document.getElementById('f-company');
  const fDesignation = document.getElementById('f-designation');
  const fEmail = document.getElementById('f-email') as HTMLAnchorElement | null;
  const fPhone = document.getElementById('f-phone') as HTMLAnchorElement | null;
  const fCity = document.getElementById('f-city');
  const fFacility = document.getElementById('f-facility');
  const fService = document.getElementById('f-service');
  const fMessage = document.getElementById('f-message');
  const fSource = document.getElementById('f-source');
  const fCreated = document.getElementById('f-created');
  const fUpdated = document.getElementById('f-updated');

  if (fName) fName.textContent = lead.name;
  if (fCompany) fCompany.textContent = lead.company || '—';
  if (fDesignation) fDesignation.textContent = lead.designation || '—';

  if (fEmail) {
    fEmail.textContent = lead.email || '—';
    fEmail.href = lead.email ? `mailto:${lead.email}` : '#';
  }

  if (fPhone) {
    fPhone.textContent = lead.phone;
    fPhone.href = lead.phone ? `tel:${lead.phone}` : '#';
  }

  const waBtn = document.getElementById('f-whatsapp-btn') as HTMLAnchorElement | null;
  if (waBtn && lead.phone) {
    const rawDigits = lead.phone.replace(/[^0-9]/g, '');
    const cleanDigits = rawDigits.length === 10 ? `91${rawDigits}` : rawDigits;
    waBtn.href = `https://wa.me/${cleanDigits}?text=${encodeURIComponent(`Hello ${lead.name || 'Sir/Madam'}, this is InteGrowSys following up on your enquiry for ${lead.service_interest}.`)}`;
    waBtn.classList.remove('hidden');
  }

  if (fCity) fCity.textContent = lead.city || '—';
  if (fFacility) fFacility.textContent = lead.facility_type || '—';
  if (fService) fService.textContent = lead.service_interest;
  if (fMessage) fMessage.textContent = lead.message;
  if (fSource) fSource.textContent = lead.source_path ? `/${lead.source_path.replace(/^\//, '')}` : 'Direct';
  if (fCreated) fCreated.textContent = formatDateTime(lead.created_at);
  if (fUpdated) fUpdated.textContent = formatDateTime(lead.updated_at);

  if (statusSelect) {
    statusSelect.value = lead.status;
  }
}

async function loadLead() {
  if (!leadId || leadId === 'view') {
    const breadcrumb = document.getElementById('lead-breadcrumb');
    if (breadcrumb) breadcrumb.textContent = 'Please select a lead record from the pipeline list';
    if (notesList) notesList.innerHTML = `<div class="py-8 text-center text-slate-400 text-xs">No lead selected</div>`;
    return;
  }

  try {
    const res = await fetch(`/api/admin/leads/${encodeURIComponent(leadId)}`);
    if (!res.ok) throw new Error('Lead not found');
    const lead = (await res.json()) as LeadRecord;
    currentLead = lead;
    renderLead(lead);
    loadNotes();
  } catch (err) {
    console.error('Load lead failed:', err);
    const breadcrumb = document.getElementById('lead-breadcrumb');
    if (breadcrumb) breadcrumb.textContent = 'Failed to load lead';
  }
}

statusSelect?.addEventListener('change', async () => {
  if (!currentLead || !statusSelect) return;
  const newStatus = statusSelect.value;
  if (newStatus === currentLead.status) return;

  statusSelect.disabled = true;
  try {
    const res = await fetch(`/api/admin/leads/${encodeURIComponent(leadId)}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: newStatus })
    });
    if (!res.ok) throw new Error('Failed to update status');
    currentLead.status = newStatus;
    showToast(`Status updated to "${newStatus}"`, 'success');
  } catch (err) {
    console.error('Status update failed:', err);
    showToast('Failed to update status', 'error');
    statusSelect.value = currentLead.status;
  } finally {
    statusSelect.disabled = false;
  }
});

noteForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!noteText || !leadId) return;
  const text = noteText.value.trim();
  if (!text) return;

  const submitBtn = noteForm.querySelector<HTMLButtonElement>('button');
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Saving...';
  }

  try {
    const res = await fetch(`/api/admin/leads/${encodeURIComponent(leadId)}/notes`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text })
    });
    if (!res.ok) throw new Error('Failed to add note');
    noteText.value = '';
    loadNotes();
    showToast('Internal note saved successfully', 'success');
  } catch (err) {
    console.error('Add note failed:', err);
    showToast('Failed to save note', 'error');
  } finally {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = `<svg class="w-3.5 h-3.5 inline mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>Post Note`;
    }
  }
});

loadLead();
</script>
