---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { 
  Download, 
  Filter, 
  RotateCcw 
} from '@lucide/astro';
---

<AdminLayout title="Leads Pipeline | InteGrowSys Admin">
  <!-- Top Header with Export Action -->
  <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 tracking-tight">
        Leads & Enquiries Pipeline
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        Search, filter, update statuses, and export inbound prospective client records.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <button 
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs bg-slate-900 hover:bg-blue-600 text-white shadow-sm transition active:scale-[0.98]" 
        id="export-btn" 
        type="button"
      >
        <Download class="w-3.5 h-3.5" />
        <span>Export Filtered CSV</span>
      </button>
    </div>
  </header>

  <!-- Modern Filters Card -->
  <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm mb-6">
    <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-4">
      <Filter class="w-3.5 h-3.5 text-blue-600" />
      <span>Filter & Slice Pipeline</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      
      <!-- Status Filter -->
      <div>
        <label for="status-filter" class="block text-xs font-bold text-slate-700 mb-1">Status</label>
        <select 
          id="status-filter" 
          class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none"
        >
          <option value="">All Statuses</option>
          <option value="new">New (Needs Action)</option>
          <option value="contacted">Contacted</option>
          <option value="qualified">Qualified</option>
          <option value="proposal">Proposal Sent</option>
          <option value="won">Won / Closed</option>
          <option value="lost">Lost</option>
          <option value="spam">Spam / Junk</option>
        </select>
      </div>

      <!-- Service Filter -->
      <div>
        <label for="service-filter" class="block text-xs font-bold text-slate-700 mb-1">Service Interest</label>
        <select 
          id="service-filter" 
          class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none"
        >
          <option value="">All Services</option>
          <option value="Fire Safety AMC & Maintenance">Fire Safety AMC & Maintenance</option>
          <option value="Fire Alarm Systems">Fire Alarm Systems</option>
          <option value="Fire Hydrant & Sprinkler Systems">Fire Hydrant & Sprinkler Systems</option>
          <option value="Fire Safety Audit & Training">Fire Safety Audit & Training</option>
          <option value="Fire Pump Systems">Fire Pump Systems</option>
          <option value="Smart Monitoring & IoT">Smart Monitoring & IoT</option>
          <option value="Pressurization & Basement Ventilation">Pressurization & Basement Ventilation</option>
          <option value="CCTV, Access Control & Networking">CCTV, Access Control & Networking</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <!-- Date From -->
      <div>
        <label for="date-from" class="block text-xs font-bold text-slate-700 mb-1">From Date</label>
        <input 
          type="date" 
          id="date-from" 
          class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none"
        />
      </div>

      <!-- Date To -->
      <div>
        <label for="date-to" class="block text-xs font-bold text-slate-700 mb-1">To Date</label>
        <input 
          type="date" 
          id="date-to" 
          class="w-full px-3 py-2 rounded-xl border border-slate-300 bg-white text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none"
        />
      </div>

      <!-- Reset Action -->
      <div class="flex items-end">
        <button 
          class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 transition" 
          id="clear-filters" 
          type="button"
        >
          <RotateCcw class="w-3.5 h-3.5" />
          <span>Reset Filters</span>
        </button>
      </div>

    </div>
  </div>

  <!-- Modern Leads Table Card -->
  <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[11px] font-bold uppercase tracking-wider text-slate-500">
            <th class="py-3 px-6">Lead / Organization</th>
            <th class="py-3 px-6">Service Required</th>
            <th class="py-3 px-6">Contact Phone</th>
            <th class="py-3 px-6">Email</th>
            <th class="py-3 px-6">Location</th>
            <th class="py-3 px-6">Date</th>
            <th class="py-3 px-6">Status</th>
            <th class="py-3 px-6 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="leads-table-body" class="divide-y divide-slate-100 text-sm">
          <tr>
            <td colspan="8" class="py-12 text-center text-slate-400 text-sm">
              <div class="inline-block w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full animate-spin mb-2"></div>
              <div>Loading leads records...</div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination Bar -->
  <div 
    id="pagination" 
    class="flex flex-wrap items-center justify-between gap-4 bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm text-xs font-semibold text-slate-600"
  ></div>
</AdminLayout>

<script>
interface LeadRecord {
  id: string;
  name: string;
  company?: string | null;
  designation?: string | null;
  service_interest: string;
  phone: string;
  email?: string | null;
  city?: string | null;
  created_at: number;
  status: string;
}

interface LeadsResponse {
  data?: LeadRecord[];
  total?: number;
  page?: number;
  limit?: number;
}

const STATE = {
  page: 1,
  limit: 20,
  total: 0,
  totalPages: 1
};

const ESC_MAP: Record<string, string> = {
  '&': '&amp;',
  '<': '&lt;',
  '>': '&gt;',
  '"': '&quot;',
  "'": '&#39;'
};

function escapeHtml(str: unknown): string {
  return String(str ?? '').replace(/[&<>"']/g, c => ESC_MAP[c] || c);
}

function formatDate(ts: unknown): string {
  if (!ts) return '—';
  const d = new Date(typeof ts === 'number' ? ts * 1000 : String(ts));
  return d.toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
}

function getStatusBadge(status: string): string {
  const s = status.toLowerCase();
  let color = 'bg-slate-100 text-slate-700 border-slate-200';
  if (s === 'new') color = 'bg-blue-50 text-blue-700 border-blue-200';
  else if (s === 'contacted') color = 'bg-cyan-50 text-cyan-700 border-cyan-200';
  else if (s === 'qualified') color = 'bg-purple-50 text-purple-700 border-purple-200';
  else if (s === 'proposal') color = 'bg-amber-50 text-amber-700 border-amber-200';
  else if (s === 'won') color = 'bg-emerald-50 text-emerald-700 border-emerald-200';
  else if (s === 'lost') color = 'bg-rose-50 text-rose-700 border-rose-200';
  else if (s === 'spam') color = 'bg-slate-100 text-slate-500 border-slate-200';

  return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold border capitalize ${color}">${escapeHtml(status)}</span>`;
}

const statusFilter = document.getElementById('status-filter') as HTMLSelectElement | null;
const serviceFilter = document.getElementById('service-filter') as HTMLSelectElement | null;
const dateFrom = document.getElementById('date-from') as HTMLInputElement | null;
const dateTo = document.getElementById('date-to') as HTMLInputElement | null;
const clearBtn = document.getElementById('clear-filters');
const exportBtn = document.getElementById('export-btn');
const tbody = document.getElementById('leads-table-body');
const pagination = document.getElementById('pagination');

function buildQuery() {
  const params = new URLSearchParams();
  params.set('page', String(STATE.page));
  params.set('limit', String(STATE.limit));
  if (statusFilter?.value) params.set('status', statusFilter.value);
  if (serviceFilter?.value) params.set('service', serviceFilter.value);
  if (dateFrom?.value) params.set('from', dateFrom.value);
  if (dateTo?.value) params.set('to', dateTo.value);
  return params.toString();
}

function renderLeads(leads: LeadRecord[]) {
  if (!tbody) return;
  if (!leads.length) {
    tbody.innerHTML = `<tr><td colspan="8" class="py-12 text-center text-slate-400 text-sm">No enquiries match the selected filter criteria.</td></tr>`;
    return;
  }
  tbody.innerHTML = leads.map(lead => `
    <tr class="hover:bg-slate-50/70 transition">
      <td class="py-4 px-6">
        <div class="font-bold text-slate-900">${escapeHtml(lead.name)}</div>
        <div class="text-xs text-slate-500">${escapeHtml(lead.company || '—')}</div>
      </td>
      <td class="py-4 px-6">
        <span class="inline-block text-xs font-medium text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md">
          ${escapeHtml(lead.service_interest)}
        </span>
      </td>
      <td class="py-4 px-6 font-mono text-xs">
        <a href="tel:${escapeHtml(lead.phone)}" class="text-blue-600 hover:underline">${escapeHtml(lead.phone)}</a>
      </td>
      <td class="py-4 px-6 text-xs text-slate-500">
        ${lead.email ? `<a href="mailto:${escapeHtml(lead.email)}" class="text-blue-600 hover:underline">${escapeHtml(lead.email)}</a>` : '—'}
      </td>
      <td class="py-4 px-6 text-xs text-slate-600">${escapeHtml(lead.city || '—')}</td>
      <td class="py-4 px-6 text-xs text-slate-500">${formatDate(lead.created_at)}</td>
      <td class="py-4 px-6">${getStatusBadge(lead.status)}</td>
      <td class="py-4 px-6 text-right">
        <a 
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 transition" 
          href="/admin/leads/${encodeURIComponent(lead.id)}" 
          title="Open detail"
        >
          <span>Open</span>
          <span>→</span>
        </a>
      </td>
    </tr>
  `).join('');
}

function renderPagination() {
  if (!pagination) return;
  if (STATE.totalPages <= 1) {
    pagination.style.display = 'none';
    return;
  }
  pagination.style.display = 'flex';
  const start = Math.max(1, STATE.page - 2);
  const end = Math.min(STATE.totalPages, STATE.page + 2);
  
  let html = `<div class="flex items-center gap-1">`;
  
  if (STATE.page > 1) {
    html += `<button data-page="${STATE.page - 1}" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 transition">Previous</button>`;
  }
  for (let i = start; i <= end; i++) {
    if (i === STATE.page) {
      html += `<span class="px-3 py-1.5 rounded-lg bg-blue-600 text-white font-bold">${i}</span>`;
    } else {
      html += `<button data-page="${i}" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 transition">${i}</button>`;
    }
  }
  if (STATE.page < STATE.totalPages) {
    html += `<button data-page="${STATE.page + 1}" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-100 transition">Next</button>`;
  }
  html += `</div>`;

  html += `<span class="text-xs text-slate-500">Showing page ${STATE.page} of ${STATE.totalPages} (${STATE.total} total)</span>`;
  pagination.innerHTML = html;
}

async function loadLeads() {
  if (!tbody) return;
  tbody.innerHTML = `<tr><td colspan="8" class="py-12 text-center text-slate-400 text-sm">Loading leads...</td></tr>`;
  try {
    const res = await fetch(`/api/admin/leads?${buildQuery()}`);
    const data = (await res.json()) as LeadsResponse;
    STATE.total = data.total ?? 0;
    STATE.totalPages = Math.max(1, Math.ceil(STATE.total / STATE.limit));
    renderLeads(data.data ?? []);
    renderPagination();
  } catch (err) {
    console.error('Load leads failed:', err);
    tbody.innerHTML = `<tr><td colspan="8" class="py-12 text-center text-rose-600 text-sm font-semibold">Failed to load leads from /api/admin/leads.</td></tr>`;
  }
}

statusFilter?.addEventListener('change', () => { STATE.page = 1; loadLeads(); });
serviceFilter?.addEventListener('change', () => { STATE.page = 1; loadLeads(); });
dateFrom?.addEventListener('change', () => { STATE.page = 1; loadLeads(); });
dateTo?.addEventListener('change', () => { STATE.page = 1; loadLeads(); });

clearBtn?.addEventListener('click', () => {
  if (statusFilter) statusFilter.value = '';
  if (serviceFilter) serviceFilter.value = '';
  if (dateFrom) dateFrom.value = '';
  if (dateTo) dateTo.value = '';
  STATE.page = 1;
  loadLeads();
});

pagination?.addEventListener('click', (e) => {
  const target = (e.target as HTMLElement).closest('button[data-page]');
  if (target) {
    const p = Number(target.getAttribute('data-page'));
    if (p && p !== STATE.page) {
      STATE.page = p;
      loadLeads();
    }
  }
});

exportBtn?.addEventListener('click', () => {
  const params = new URLSearchParams();
  if (statusFilter?.value) params.set('status', statusFilter.value);
  if (serviceFilter?.value) params.set('service', serviceFilter.value);
  if (dateFrom?.value) params.set('from', dateFrom.value);
  if (dateTo?.value) params.set('to', dateTo.value);
  window.location.href = `/api/admin/leads/export?${params.toString()}`;
});

loadLeads();
</script>
