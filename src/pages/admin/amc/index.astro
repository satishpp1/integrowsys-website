---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { 
  CalendarCheck, 
  Sparkles,
  Plus,
  X,
  Download
} from '@lucide/astro';
---

<AdminLayout title="AMC Management Portal | InteGrowSys Admin">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider mb-2">
          <CalendarCheck class="w-3.5 h-3.5 text-emerald-600" />
          <span>Facility Webapp · Interactive Workspace</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-heading font-black text-slate-900 tracking-tight">
          AMC Contracts & Statutory Form-B Portal
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Track client facility preventative maintenance schedules, quarterly pump tests, and statutory Form-B compliance renewals.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <button 
          type="button"
          id="btn-export-csv"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold bg-white text-slate-700 hover:bg-slate-50 border border-slate-300 shadow-sm transition"
        >
          <Download class="w-3.5 h-3.5" />
          <span>Export Register (CSV)</span>
        </button>

        <button 
          type="button" 
          id="btn-open-modal"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm transition active:scale-[0.98]"
        >
          <Plus class="w-4 h-4" />
          <span>Add AMC Contract</span>
        </button>
      </div>
    </header>

    <!-- Architecture Roadmap Notice Banner -->
    <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-slate-900 border border-emerald-800/40 rounded-2xl p-6 text-white shadow-lg">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase text-emerald-400">
            <Sparkles class="w-4 h-4 text-emerald-400" />
            <span>Architecture Roadmap</span>
          </div>
          <h2 class="text-lg font-heading font-bold text-white">
            Upcoming D1 Schema: <code class="text-emerald-300 font-mono text-sm">amc_contracts</code> & <code class="text-emerald-300 font-mono text-sm">amc_schedules</code>
          </h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            This module automatically calculates Maharashtra Fire Service Form-B biannual filing deadlines (January & July) based on client equipment inventories, dispatches service engineer reminders, and tracks pump performance histories.
          </p>
        </div>

        <div class="shrink-0 flex flex-col gap-2 text-xs font-mono">
          <div class="px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700/80 text-emerald-400">
            ✓ Form-B Statutory Compliance Tracker
          </div>
          <div class="px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700/80 text-blue-400">
            ✓ Quarterly Service Dispatch Allocations
          </div>
          <div class="px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700/80 text-amber-400">
            ✓ Pump Run & Churn Reading Logs
          </div>
        </div>
      </div>
    </div>

    <!-- Active Contracts Register -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h2 class="font-heading font-bold text-base text-slate-900">
            Client AMC Contracts Register
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Active contracts across Pune industrial zones, IT corridors, and commercial high-rises</p>
        </div>
        <span id="contracts-counter" class="text-xs font-bold text-slate-600 bg-slate-100 px-3 py-1 rounded-full">
          Loading...
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50 border-b border-slate-100 text-xs font-bold uppercase tracking-wider text-slate-500">
            <tr>
              <th class="py-3.5 px-6">Facility & Location</th>
              <th class="py-3.5 px-6">Scope of Contract</th>
              <th class="py-3.5 px-6">Form-B Status</th>
              <th class="py-3.5 px-6">Last Quarterly Test</th>
              <th class="py-3.5 px-6">Next Renewal</th>
              <th class="py-3.5 px-6 text-right">Action</th>
            </tr>
          </thead>
          <tbody id="contracts-table-body" class="divide-y divide-slate-100">
            <!-- Rendered by client script -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Add AMC Contract Modal -->
  <div id="modal-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full shadow-2xl border border-slate-200 overflow-hidden transform transition-all">
      <div class="px-6 py-5 bg-slate-900 text-white flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-600 text-white flex items-center justify-center">
            <CalendarCheck class="w-4 h-4" />
          </div>
          <div>
            <h3 class="font-heading font-bold text-base text-white">Add New AMC Contract</h3>
            <p class="text-xs text-slate-400">Onboard client facility for planned maintenance & Form-B</p>
          </div>
        </div>
        <button id="btn-close-modal" type="button" class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-slate-800 transition">
          <X class="w-5 h-5" />
        </button>
      </div>

      <form id="form-add-amc" class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Facility / Building Name *</label>
          <input type="text" id="inp-facility" required placeholder="e.g. Cummins India Campus Tower B" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 outline-none" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">City / MIDC Zone *</label>
            <input type="text" id="inp-location" required placeholder="e.g. Balewadi / Chakan, Pune" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 outline-none" />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Scope of AMC *</label>
            <select id="inp-scope" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm bg-white focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 outline-none">
              <option value="Comprehensive Fire AMC + Pump Supervision">Comprehensive Fire AMC + Pump Supervision</option>
              <option value="Hydrant & Sprinkler Semi-Comprehensive AMC">Hydrant & Sprinkler Semi-Comprehensive</option>
              <option value="Addressable Fire Alarm & PA Network AMC">Addressable Fire Alarm & PA Network</option>
              <option value="Fire Pump Room & Engine Overhaul AMC">Fire Pump Room & Engine Overhaul</option>
              <option value="Statutory Form-B Compliance Audit Only">Statutory Form-B Compliance Only</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Form-B Status *</label>
            <select id="inp-formb" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm bg-white focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 outline-none">
              <option value="Valid (Current Cycle)">Valid (Current Cycle)</option>
              <option value="Renewal Due in Jan Cycle">Renewal Due in Jan Cycle</option>
              <option value="Renewal Due in July Cycle">Renewal Due in July Cycle</option>
              <option value="Inspection Pending">Inspection Pending</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Next Annual Renewal Date *</label>
            <input type="date" id="inp-renewal" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm focus:border-emerald-600 focus:ring-2 focus:ring-emerald-500/20 outline-none" />
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
          <button type="button" id="btn-cancel-modal" class="px-4 py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition">
            Cancel
          </button>
          <button type="submit" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition active:scale-[0.98]">
            Save AMC Contract
          </button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  interface ContractItem {
    id: string;
    facility: string;
    location: string;
    serviceType: string;
    renewalDue: string;
    formBStatus: string;
    lastQuarterlyTest: string;
    status: string;
  }

  const STORAGE_KEY = 'integrowsys_amc_contracts';

  const defaultContracts: ContractItem[] = [
    {
      id: 'AMC-2026-001',
      facility: 'Magarpatta Cybercity Tower 4',
      location: 'Hadapsar, Pune',
      serviceType: 'Comprehensive Fire AMC + Pump Supervision',
      renewalDue: '15 Jan 2027',
      formBStatus: 'Valid (Form-B Filed July)',
      lastQuarterlyTest: '12 Oct 2026',
      status: 'active'
    },
    {
      id: 'AMC-2026-002',
      facility: 'Khed City Industrial Logistics Zone',
      location: 'Chakan MIDC, Pune',
      serviceType: 'Hydrant & Sprinkler Semi-Comprehensive AMC',
      renewalDue: '28 Feb 2027',
      formBStatus: 'Renewal Required by Jan',
      lastQuarterlyTest: '04 Nov 2026',
      status: 'upcoming'
    },
    {
      id: 'AMC-2026-003',
      facility: 'ICC Trade Tower Complex',
      location: 'Senapati Bapat Road, Pune',
      serviceType: 'Addressable Fire Alarm & PA System AMC',
      renewalDue: '10 Apr 2027',
      formBStatus: 'Valid',
      lastQuarterlyTest: '18 Sep 2026',
      status: 'active'
    }
  ];

  function getContracts(): ContractItem[] {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        return JSON.parse(stored);
      }
    } catch (e) {
      console.error('Error reading localStorage:', e);
    }
    return defaultContracts;
  }

  function saveContracts(list: ContractItem[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    } catch (e) {
      console.error('Error saving to localStorage:', e);
    }
  }

  const tbody = document.getElementById('contracts-table-body');
  const counter = document.getElementById('contracts-counter');

  function renderTable() {
    const list = getContracts();
    if (counter) {
      counter.textContent = `${list.length} Contracts Active`;
    }

    if (!tbody) return;

    if (!list.length) {
      tbody.innerHTML = `<tr><td colspan="6" class="py-12 text-center text-slate-400 text-sm">No AMC contracts logged. Click "Add AMC Contract" above to record one.</td></tr>`;
      return;
    }

    tbody.innerHTML = list.map((c, index) => `
      <tr class="hover:bg-slate-50/70 transition">
        <td class="py-4 px-6">
          <div class="font-bold text-slate-900">${escapeHtml(c.facility)}</div>
          <div class="text-xs text-slate-500">${escapeHtml(c.location)}</div>
        </td>
        <td class="py-4 px-6">
          <span class="text-xs font-medium text-slate-700 bg-slate-100 px-2.5 py-1 rounded-md">
            ${escapeHtml(c.serviceType)}
          </span>
        </td>
        <td class="py-4 px-6 text-xs font-medium text-emerald-700">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>${escapeHtml(c.formBStatus)}</span>
          </span>
        </td>
        <td class="py-4 px-6 text-xs text-slate-600 font-mono">
          ${escapeHtml(c.lastQuarterlyTest)}
        </td>
        <td class="py-4 px-6 text-xs font-bold text-slate-800">
          ${escapeHtml(c.renewalDue)}
        </td>
        <td class="py-4 px-6 text-right">
          <button 
            type="button" 
            data-index="${index}" 
            class="btn-delete-contract text-xs text-rose-600 hover:text-rose-800 font-semibold px-2 py-1 rounded hover:bg-rose-50 transition"
            title="Delete this record"
          >
            Delete
          </button>
        </td>
      </tr>
    `).join('');

    // Attach delete listeners
    document.querySelectorAll('.btn-delete-contract').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = Number((e.currentTarget as HTMLElement).getAttribute('data-index'));
        const currentList = getContracts();
        if (confirm(`Remove AMC contract for "${currentList[idx]?.facility}"?`)) {
          currentList.splice(idx, 1);
          saveContracts(currentList);
          renderTable();
        }
      });
    });
  }

  function escapeHtml(str: string): string {
    return String(str || '').replace(/[&<>"']/g, (m) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;'
    }[m] || m));
  }

  // Modal Handlers
  const modal = document.getElementById('modal-backdrop');
  const btnOpen = document.getElementById('btn-open-modal');
  const btnClose = document.getElementById('btn-close-modal');
  const btnCancel = document.getElementById('btn-cancel-modal');
  const form = document.getElementById('form-add-amc') as HTMLFormElement | null;

  btnOpen?.addEventListener('click', () => modal?.classList.remove('hidden'));
  btnClose?.addEventListener('click', () => modal?.classList.add('hidden'));
  btnCancel?.addEventListener('click', () => modal?.classList.add('hidden'));

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const facility = (document.getElementById('inp-facility') as HTMLInputElement)?.value.trim();
    const location = (document.getElementById('inp-location') as HTMLInputElement)?.value.trim();
    const scope = ((document.getElementById('inp-scope') as unknown) as HTMLSelectElement)?.value;
    const formb = ((document.getElementById('inp-formb') as unknown) as HTMLSelectElement)?.value;
    const renewalRaw = (document.getElementById('inp-renewal') as HTMLInputElement)?.value;

    if (!facility || !location || !renewalRaw) return;

    const renewalFormatted = new Date(renewalRaw).toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });

    const nowFormatted = new Date().toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });

    const newContract: ContractItem = {
      id: `AMC-2026-${String(Date.now()).slice(-3)}`,
      facility,
      location,
      serviceType: scope,
      renewalDue: renewalFormatted,
      formBStatus: formb,
      lastQuarterlyTest: nowFormatted,
      status: 'active'
    };

    const currentList = getContracts();
    currentList.unshift(newContract);
    saveContracts(currentList);
    renderTable();

    form.reset();
    modal?.classList.add('hidden');
    alert(`✓ AMC Contract for "${facility}" has been saved to your register!`);
  });

  // Export CSV Handler
  document.getElementById('btn-export-csv')?.addEventListener('click', () => {
    const list = getContracts();
    if (!list.length) return alert('No contracts to export');
    const headers = ['ID', 'Facility', 'Location', 'Service Scope', 'Form-B Status', 'Last Quarterly Test', 'Next Renewal Due', 'Status'];
    const rows = list.map(c => [
      c.id,
      `"${c.facility.replace(/"/g, '""')}"`,
      `"${c.location.replace(/"/g, '""')}"`,
      `"${c.serviceType.replace(/"/g, '""')}"`,
      `"${c.formBStatus.replace(/"/g, '""')}"`,
      c.lastQuarterlyTest,
      c.renewalDue,
      c.status
    ]);
    const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const encodedUri = encodeURI(csvContent);
    const link = document.createElement('a');
    link.setAttribute('href', encodedUri);
    link.setAttribute('download', `integrowsys_amc_register_${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
    link.remove();
  });

  // Initial render
  renderTable();
</script>
