---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contact InteGrowSys | Request a Site Survey"
  description="Contact InteGrowSys for fire safety services, maintenance, building systems integration or a smart monitoring assessment."
>
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs"><a href="/">Home</a> / Contact</div>
      <div class="eyebrow">Start a conversation</div>
      <h1>Tell us about your facility and what you want to improve.</h1>
      <p class="lead">
        Request a quotation, site survey or assessment of whether your existing
        alarm or building systems can support smarter monitoring.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-panel">
        <h2>Contact details</h2>
        <p>InteGrowSys</p>

        <p><strong>Email</strong><br />
          <a href="mailto:crm@integrowsys.com">crm@integrowsys.com</a>
        </p>

        <p><strong>Phone</strong><br />
          <a href="tel:+919860027825">+91 98600 27825</a><br />
          <a href="tel:+917507600091">+91 75076 00091</a>
        </p>

        <p><strong>Office</strong><br />
          B25, Erica, Magarpatta City, Hadapsar, Pune, Maharashtra 411013
        </p>

        <a class="button" href="mailto:crm@integrowsys.com?subject=InteGrowSys%20Site%20Assessment">
          Email an enquiry
        </a>

        <div style="margin-top: 2rem;">
          <h3>What can we help with?</h3>
          <ul class="check-list">
            <li>Fire alarm system or panel interface</li>
            <li>Fire hydrant, sprinkler or fire pump system</li>
            <li>Fire Safety AMC, audit or training</li>
            <li>Pressurization or basement ventilation</li>
            <li>CCTV, access control or networking</li>
            <li>Remote alarm/fault notifications</li>
            <li>Pump status, pressure, temperature, humidity or water leak monitoring</li>
          </ul>
        </div>
      </div>

      <div class="contact-panel">
        <h2>Send us an enquiry</h2>
        <p>
          Share a few details about your facility and requirements.
          Our team will get in touch with you.
        </p>

        <form id="lead-form">
          <div class="form-field">
            <label for="name">Your name *</label>
            <input id="name" name="name" type="text" maxlength="100" required autocomplete="name" />
          </div>

          <div class="form-field">
            <label for="company">Company / Organisation</label>
            <input id="company" name="company" type="text" maxlength="150" autocomplete="organization" />
          </div>

          <div class="form-field">
            <label for="designation">Designation</label>
            <input id="designation" name="designation" type="text" maxlength="100" autocomplete="organization-title" />
          </div>

          <div class="form-field">
            <label for="email">Business email</label>
            <input id="email" name="email" type="email" maxlength="254" autocomplete="email" />
          </div>

          <div class="form-field">
            <label for="phone">Phone number *</label>
            <input id="phone" name="phone" type="tel" maxlength="30" required autocomplete="tel" />
          </div>

          <div class="form-field">
            <label for="city">City / Location</label>
            <input id="city" name="city" type="text" maxlength="100" autocomplete="address-level2" />
          </div>

          <div class="form-field">
            <label for="facility_type">Facility type</label>
            <select id="facility_type" name="facility_type">
              <option value="">Select facility type</option>
              <option>Manufacturing / Industrial</option>
              <option>IT Park / Office</option>
              <option>Commercial Complex / Mall</option>
              <option>Hospital / Healthcare</option>
              <option>Educational Institution</option>
              <option>Residential / Housing Society</option>
              <option>Warehouse / Logistics</option>
              <option>Other</option>
            </select>
          </div>

          <div class="form-field">
            <label for="service_interest">Service required *</label>
            <select id="service_interest" name="service_interest" required>
              <option value="">Select a service</option>
              <option>Fire Safety AMC &amp; Maintenance</option>
              <option>Fire Alarm Systems</option>
              <option>Fire Hydrant &amp; Sprinkler Systems</option>
              <option>Fire Safety Audit &amp; Training</option>
              <option>Fire Pump Systems</option>
              <option>Smart Monitoring &amp; IoT</option>
              <option>Pressurization &amp; Basement Ventilation</option>
              <option>CCTV, Access Control &amp; Networking</option>
              <option>Other</option>
            </select>
          </div>

          <div class="form-field">
            <label for="message">Enquiry details *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              maxlength="3000"
              required
              placeholder="Describe your requirements, existing systems, site location or any specific issue..."
            ></textarea>
          </div>

          <div class="form-honeypot" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-field consent-field">
            <label>
              <input type="checkbox" name="consent" id="consent" required />
              I agree to be contacted by InteGrowSys regarding this enquiry.
            </label>
          </div>

          <button class="button" type="submit" id="submit-button">
            Submit enquiry
          </button>

          <p id="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </section>

  <style>
    .form-field {
      margin-bottom: 1rem;
    }

    .form-field label {
      display: block;
      margin-bottom: 0.4rem;
      font-weight: 600;
    }

    .form-field input:not([type="checkbox"]),
    .form-field select,
    .form-field textarea {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 0.75rem;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font: inherit;
      background: #fff;
      color: #172033;
    }

    .form-field textarea {
      resize: vertical;
    }

    .consent-field label {
      display: flex;
      align-items: flex-start;
      gap: 0.6rem;
      font-weight: 400;
    }

    .consent-field input {
      margin-top: 0.25rem;
    }

    .form-honeypot {
      position: absolute;
      left: -10000px;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }

    #form-status {
      margin-top: 1rem;
      font-weight: 600;
    }

    #form-status.success {
      color: #15803d;
    }

    #form-status.error {
      color: #b91c1c;
    }

    #submit-button:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }
  </style>

  <script>
    const form = document.querySelector<HTMLFormElement>('#lead-form');
    const submitButton = document.querySelector<HTMLButtonElement>('#submit-button');
    const formStatus = document.querySelector<HTMLParagraphElement>('#form-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity() || !submitButton || !formStatus) return;

      submitButton.disabled = true;
      submitButton.textContent = 'Submitting...';
      formStatus.textContent = '';
      formStatus.className = '';

      const formData = new FormData(form);

      const payload = {
        name: formData.get('name'),
        company: formData.get('company'),
        designation: formData.get('designation'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        city: formData.get('city'),
        facility_type: formData.get('facility_type'),
        service_interest: formData.get('service_interest'),
        message: formData.get('message'),
        website: formData.get('website'),
        consent: formData.get('consent') === 'on'
      };

      try {
        const response = await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result: unknown = await response.json();

        if (
          typeof result !== 'object' ||
          result === null ||
          !('success' in result) ||
          typeof result.success !== 'boolean' ||
          !('message' in result) ||
          typeof result.message !== 'string'
        ) {
          throw new Error('Unexpected response from the server. Please try again.');
        }

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Unable to submit your enquiry.');
        }

        formStatus.textContent = result.message;
        formStatus.className = 'success';
        form.reset();

              } catch (error) {
         formStatus.textContent =
           error instanceof Error
             ? error.message
             : 'Something went wrong. Please try again or email crm@integrowsys.com.';
         formStatus.className = 'error';

      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Submit enquiry';
      }
    });
  </script>
</MainLayout>
